# === YouTube Data API v3 ===
# Obtén tu API key en: https://console.cloud.google.com/apis/credentials
# Activa "YouTube Data API v3" en tu proyecto de Google Cloud
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# === RapidAPI (para Instagram y Facebook) ===
# Regístrate gratis en: https://rapidapi.com
# Suscríbete a "Instagram Scraper API" y "Facebook Scraper API"
RAPIDAPI_KEY=tu_rapidapi_key_aqui

# === Gmail SMTP ===
# Usa una "App Password" de Google, NO tu contraseña normal
# Guía: https://support.google.com/accounts/answer/185833
GMAIL_USER=tu_email@gmail.com
GMAIL_APP_PASSWORD=tu_app_password_aqui

# === Destinatario del reporte ===
REPORT_EMAIL=tu_email@gmail.com

# === Configuración opcional ===
# Número máximo de resultados por plataforma por tema
MAX_RESULTS_PER_TOPIC=5
